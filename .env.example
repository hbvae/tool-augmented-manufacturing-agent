# OpenAI-compatible model configuration. Do not commit the real key.
MANUFACTURING_LLM_API_KEY=replace-with-your-key
MANUFACTURING_LLM_BASE_URL=https://api.deepseek.com
MANUFACTURING_LLM_MODEL=deepseek-chat
MANUFACTURING_LLM_TEMPERATURE=0
MANUFACTURING_LLM_MAX_RETRIES=2

# Optional overrides. By default the client reuses .vscode/mcp.json.
# MANUFACTURING_MCP_CONFIG=.vscode\mcp.json
# MANUFACTURING_MCP_SERVER=manufacturing-data
# MANUFACTURING_NODE_COMMAND=C:\path\to\node.exe

# These values override the matching MCP child-process environment when set.
# MANUFACTURING_AIO_API_KEY=replace-with-the-sandbox-key
# 外部检索。正式对比实验建议固定为 baidu，不使用自动回退。
MANUFACTURING_EXTERNAL_SEARCH_PROVIDER=baidu
MANUFACTURING_EXTERNAL_CONTENT_PROVIDER=search_snippet
MANUFACTURING_AGENT_MODEL_CALL_TIMEOUT_SECONDS=150
MANUFACTURING_AGENT_MODEL_CALL_TIMEOUT_RETRIES=1
MANUFACTURING_AGENT_EXTERNAL_SEARCH_STOP_CALLS=4
# BAIDU_AI_SEARCH_API_KEY=your-baidu-ai-search-key
# 日常使用若需要百度失败后回退 Tavily，可改为 baidu_fallback 并配置下一行。
# TAVILY_API_KEY=tvly-your-real-key
